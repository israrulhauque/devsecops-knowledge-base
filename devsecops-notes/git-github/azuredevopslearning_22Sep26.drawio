        <mxCell id="Yi_OugeGimB1xCWwgO_h-9" parent="1" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Remote s changes lekr aata h but ye merge nhi karta h&amp;nbsp;" vertex="1">
