        <mxCell id="bPllanAipsPgOedq6P1s-15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="git upstream&amp;nbsp;" vertex="1">
