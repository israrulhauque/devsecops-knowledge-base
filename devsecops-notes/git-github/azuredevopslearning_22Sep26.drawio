          <mxGeometry height="40" width="110" x="240" y="8210" as="geometry" />
        </mxCell>
        <mxCell id="3HZLZrsV24J5N5C5s_OY-16" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
