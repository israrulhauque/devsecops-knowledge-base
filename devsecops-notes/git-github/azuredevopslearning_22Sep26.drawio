        <mxCell id="8QuN20aMnpxbNQyWhhUr-1" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;strong data-start=&quot;58&quot; data-end=&quot;83&quot;&gt;OIDC (OpenID Connect)&lt;/strong&gt; is an &lt;strong data-start=&quot;90&quot; data-end=&quot;117&quot;&gt;authentication protocol&lt;/strong&gt; that allows one system to verify the identity of another system/user using a &lt;strong data-start=&quot;195&quot; data-end=&quot;211&quot;&gt;secure token&lt;/strong&gt; instead of username/password or secrets." vertex="1">
          <mxGeometry height="50" width="515" x="749" y="14870" as="geometry" />
        </mxCell>
