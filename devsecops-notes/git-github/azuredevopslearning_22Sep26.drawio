        <mxCell id="G0Dou9oEb0EDADHKUUAy-103" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;pre&gt;&lt;code class=&quot;language-yaml&quot;&gt;trigger:&#xa;- main&#xa;&#xa;pool:&#xa;  name: arun_agent&#xa;&#xa;stages:&#xa;&#xa;# =========================================================&#xa;# STAGE 1 - CI / PLAN&#xa;# =========================================================&#xa;- stage: CI&#xa;  displayName: &#39;Stage 1 - Terraform Plan&#39;&#xa;&#xa;  jobs:&#xa;  - job: TerraformPlan&#xa;    displayName: &#39;Terraform Init Validate Plan&#39;&#xa;&#xa;    steps:&#xa;&#xa;    # -----------------------------------------------------&#xa;    # Install Terraform&#xa;    # -----------------------------------------------------&#xa;    - task: TerraformInstaller@1&#xa;      displayName: &#39;Task 1 - Install Terraform&#39;&#xa;      inputs:&#xa;        terraformVersion: &#39;latest&#39;&#xa;&#xa;&#xa;    # -----------------------------------------------------&#xa;    # Terraform Init&#xa;    # -----------------------------------------------------&#xa;    - task: TerraformTask@5&#xa;      displayName: &#39;Task 2 - Terraform Init&#39;&#xa;      inputs:&#xa;        provider: &#39;azurerm&#39;&#xa;        command: &#39;init&#39;&#xa;        backendServiceArm: &#39;arun_SVC&#39;&#xa;        backendAzureRmResourceGroupName: &#39;arun_rg&#39;&#xa;        backendAzureRmStorageAccountName: &#39;arunstorge3455&#39;&#xa;        backendAzureRmContainerName: &#39;devstatefile&#39;&#xa;        backendAzureRmKey: &#39;test.tfstate&#39;&#xa;&#xa;&#xa;    # -----------------------------------------------------&#xa;    # Terraform Validate&#xa;    # -----------------------------------------------------&#xa;    - task: TerraformTask@5&#xa;      displayName: &#39;Task 3 - Terraform Validate&#39;&#xa;      inputs:&#xa;        provider: &#39;azurerm&#39;&#xa;        command: &#39;validate&#39;&#xa;&#xa;&#xa;    # -----------------------------------------------------&#xa;    # Terraform Plan&#xa;    # -----------------------------------------------------&#xa;    - task: TerraformTask@5&#xa;      displayName: &#39;Task 4 - Terraform Plan&#39;&#xa;      inputs:&#xa;        provider: &#39;azurerm&#39;&#xa;        command: &#39;plan&#39;&#xa;        commandOptions: &#39;-out=tfplan&#39;&#xa;        environmentServiceNameAzureRM: &#39;arun_SVC&#39;&#xa;&#xa;&#xa;    # -----------------------------------------------------&#xa;    # Publish Terraform Plan&#xa;    # -----------------------------------------------------&#xa;    - task: PublishBuildArtifacts@1&#xa;      displayName: &#39;Task 5 - Publish Terraform Plan&#39;&#xa;      inputs:&#xa;        PathtoPublish: &#39;tfplan&#39;&#xa;        ArtifactName: &#39;terraform-plan&#39;&#xa;        publishLocation: &#39;Container&#39;&#xa;&#xa;&#xa;# =========================================================&#xa;# STAGE 2 - SECURITY SCAN&#xa;# =========================================================&#xa;- stage: Scan&#xa;  displayName: &#39;Stage 2 - Terraform Security Scan&#39;&#xa;&#xa;  dependsOn: CI&#xa;  condition: succeeded()&#xa;&#xa;  jobs:&#xa;  - job: CheckovScan&#xa;    displayName: &#39;Checkov IaC Security Scan&#39;&#xa;&#xa;    steps:&#xa;&#xa;    # -----------------------------------------------------&#xa;    # Install Python&#xa;    # -----------------------------------------------------&#xa;    - task: UsePythonVersion@0&#xa;      displayName: &#39;Task 1 - Install Python&#39;&#xa;      inputs:&#xa;        versionSpec: &#39;3.x&#39;&#xa;&#xa;&#xa;    # -----------------------------------------------------&#xa;    # Install Checkov&#xa;    # -----------------------------------------------------&#xa;    - script: |&#xa;        python -m pip install --upgrade pip&#xa;        pip install checkov&#xa;      displayName: &#39;Task 2 - Install Checkov&#39;&#xa;&#xa;&#xa;    # -----------------------------------------------------&#xa;    # Run Checkov&#xa;    # -----------------------------------------------------&#xa;    - script: |&#xa;        checkov -d . --skip-path .terraform&#xa;      displayName: &#39;Task 3 - Run Checkov Security Scan&#39;&#xa;&#xa;&#xa;# =========================================================&#xa;# STAGE 3 - CD / APPLY&#xa;# =========================================================&#xa;- stage: CD&#xa;  displayName: &#39;Stage 3 - Terraform Apply&#39;&#xa;&#xa;  dependsOn:&#xa;  - CI&#xa;  - Scan&#xa;&#xa;  condition: and(succeeded(), eq(variables[&#39;Build.SourceBranch&#39;], &#39;refs/heads/main&#39;))&#xa;&#xa;  jobs:&#xa;  - job: TerraformApply&#xa;    displayName: &#39;Terraform Apply&#39;&#xa;&#xa;    steps:&#xa;&#xa;    # -----------------------------------------------------&#xa;    # Install Terraform&#xa;    # -----------------------------------------------------&#xa;    - task: TerraformInstaller@1&#xa;      displayName: &#39;Task 1 - Install Terraform&#39;&#xa;      inputs:&#xa;        terraformVersion: &#39;latest&#39;&#xa;&#xa;&#xa;    # -----------------------------------------------------&#xa;    # Terraform Init&#xa;    # -----------------------------------------------------&#xa;    - task: TerraformTask@5&#xa;      displayName: &#39;Task 2 - Terraform Init&#39;&#xa;      inputs:&#xa;        provider: &#39;azurerm&#39;&#xa;        command: &#39;init&#39;&#xa;        backendServiceArm: &#39;arun_SVC&#39;&#xa;        backendAzureRmResourceGroupName: &#39;arun_rg&#39;&#xa;        backendAzureRmStorageAccountName: &#39;arunstorge3455&#39;&#xa;        backendAzureRmContainerName: &#39;devstatefile&#39;&#xa;        backendAzureRmKey: &#39;test.tfstate&#39;&#xa;&#xa;&#xa;    # -----------------------------------------------------&#xa;    # Download Plan Artifact&#xa;    # -----------------------------------------------------&#xa;    - task: DownloadBuildArtifacts@1&#xa;      displayName: &#39;Task 3 - Download Terraform Plan&#39;&#xa;      inputs:&#xa;        buildType: &#39;current&#39;&#xa;        downloadType: &#39;single&#39;&#xa;        artifactName: &#39;terraform-plan&#39;&#xa;        downloadPath: &#39;$(System.ArtifactsDirectory)&#39;&#xa;&#xa;&#xa;    # -----------------------------------------------------&#xa;    # Terraform Apply&#xa;    # -----------------------------------------------------&#xa;    - task: TerraformTask@5&#xa;      displayName: &#39;Task 4 - Terraform Apply&#39;&#xa;      inputs:&#xa;        provider: &#39;azurerm&#39;&#xa;        command: &#39;apply&#39;&#xa;        commandOptions: &#39;&quot;$(System.ArtifactsDirectory)\terraform-plan\tfplan&quot;&#39;&#xa;        environmentServiceNameAzureRM: &#39;arun_SVC&#39;&#xa;&lt;/code&gt;&lt;/pre&gt;" vertex="1">
