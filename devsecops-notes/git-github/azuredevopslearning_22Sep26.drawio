        <mxCell id="bPllanAipsPgOedq6P1s-16" parent="1" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Local branch ka connection remote branch (GitHub/Git server) ke saath set karna is called upstream." vertex="1">
          <mxGeometry height="60" width="190" x="70" y="5390" as="geometry" />
        </mxCell>
        <mxCell id="bPllanAipsPgOedq6P1s-20" edge="1" parent="1" source="bPllanAipsPgOedq6P1s-18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="bPllanAipsPgOedq6P1s-19" value="">
