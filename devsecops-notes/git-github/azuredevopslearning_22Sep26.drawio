        <mxCell id="1cQBTbD6I9Xxw38U7ORq-1" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Requirement&lt;/th&gt;&lt;th&gt;Azure Service&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;On-prem DB → Azure DB/Data Lake, scheduled data movement&lt;/td&gt;&lt;td&gt;&lt;strong&gt;ADF/ETL (&lt;/strong&gt;ETL = Extract → Transform → Load)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;On-prem File Server ↔ Azure Files sync&lt;/td&gt;&lt;td&gt;&lt;strong&gt;Azure File Sync&lt;/strong&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Huge bulk data transfer&lt;/td&gt;&lt;td&gt;&lt;strong&gt;Azure Data Box&lt;/strong&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Files → Azure Blob&lt;/td&gt;&lt;td&gt;&lt;strong&gt;AzCopy / Storage tools&lt;/strong&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Database migration&lt;/td&gt;&lt;td&gt;&lt;strong&gt;Azure Database Migration Service&lt;/strong&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Network connectivity between on-prem &amp;amp; Azure&lt;/td&gt;&lt;td&gt;&lt;strong&gt;VPN / ExpressRoute&lt;/strong&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="180" width="560" x="160" y="25480" as="geometry" />
        </mxCell>
