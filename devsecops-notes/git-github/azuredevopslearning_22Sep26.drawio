        </UserObject>
        <mxCell id="rEBrrHyZp_KR87rfb0lr-48" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;p class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;&lt;strong&gt;&quot;How will you integrate an application with Entra ID?&quot;&lt;/strong&gt;&lt;span aria-hidden=&quot;true&quot; class=&quot;PDq2pG_selectionAnchor&quot;&gt;&lt;/span&gt;&lt;/p&gt;&#xa;&lt;p&gt;Tum bol sakte ho:&lt;/p&gt;&#xa;&lt;blockquote&gt;&#xa;&lt;p class=&quot;&quot;&gt;&quot;First, I register the application in Microsoft Entra ID and configure the redirect URI. The application uses OpenID Connect/OAuth 2.0 for authentication and authorization. For API access, I configure API permissions, scopes or app roles. Entra ID issues ID and access tokens, which the application or API validates. For Azure resource access from the application, I prefer Managed Identity with appropriate Azure RBAC instead of storing credentials.&quot;&lt;/p&gt;&#xa;&lt;/blockquote&gt;&#xa;&lt;p&gt;&lt;strong&gt;Main components yaad rakhna:&lt;/strong&gt;&lt;/p&gt;&#xa;&lt;p&gt;&lt;code&gt;Tenant → App Registration → Client ID → Redirect URI → OIDC/OAuth → Tokens → API Permissions/Scopes → App Roles → Managed Identity/RBAC&lt;/code&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="410" width="560" x="-680" y="38610" as="geometry" />
        </mxCell>
        <mxCell id="VfkdXgMbOGRIXH-vw9D5-4" edge="1" parent="1" source="VfkdXgMbOGRIXH-vw9D5-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=12;fontColor=default;" target="VfkdXgMbOGRIXH-vw9D5-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="VfkdXgMbOGRIXH-vw9D5-5" edge="1" parent="1" source="VfkdXgMbOGRIXH-vw9D5-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=12;fontColor=default;" target="VfkdXgMbOGRIXH-vw9D5-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="VfkdXgMbOGRIXH-vw9D5-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="managed identity&amp;nbsp;" vertex="1">
