le=&quot;color: #000000;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: #007200;&quot;&gt;1&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #000000;&quot;&gt;}&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;color: #000000;&quot;&gt;Write-Host&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: #a31515;&quot;&gt;&quot;Terraform&amp;nbsp;found&amp;nbsp;successfully.&quot;&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt;&amp;nbsp;-ForegroundColor&amp;nbsp;Green&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #000000;&quot;&gt;Write-Host&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: #a31515;&quot;&gt;&quot;&quot;&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;color: #007200;&quot;&gt;#&amp;nbsp;==========================================&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #007200;&quot;&gt;#&amp;nbsp;Check&amp;nbsp;main.tf&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #007200;&quot;&gt;#&amp;nbsp;==========================================&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;color: #001188;&quot;&gt;$mainTf&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt;&amp;nbsp;=&amp;nbsp;Join-Path&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: #001188;&quot;&gt;$PSScriptRoot&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: #a31515;&quot;&gt;&quot;main.tf&quot;&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;color: #0000ff;&quot;&gt;if&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt;&amp;nbsp;(-not&amp;nbsp;(Test-Path&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: #001188;&quot;&gt;$mainTf&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt;))&amp;nbsp;{&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;color: #000000;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Write-Host&amp;nbsp;&lt;/span&