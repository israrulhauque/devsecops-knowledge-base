        <mxCell id="pFN8Bo_iyDxhCp5ajm9O-3" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;strong data-start=&quot;2330&quot; data-end=&quot;2362&quot;&gt;Service Principal = Identity&lt;/strong&gt;&lt;br data-start=&quot;2362&quot; data-end=&quot;2365&quot;&gt;&lt;br&gt;&lt;strong data-start=&quot;2365&quot; data-end=&quot;2397&quot;&gt;OIDC = Authentication method&lt;/strong&gt;&lt;br data-start=&quot;2397&quot; data-end=&quot;2400&quot;&gt;&lt;br&gt;&lt;strong data-start=&quot;2400&quot; data-end=&quot;2489&quot;&gt;Workload Identity Federation = Trust relationship using OIDC between ADO and Azure AD&lt;/strong&gt;" vertex="1">
          <mxGeometry height="90" width="541" x="745" y="15460" as="geometry" />
        </mxCell>
        <mxCell id="pFN8Bo_iyDxhCp5ajm9O-4" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="OIDC is an authentication protocol that enables secure identity verification using tokens. In Azure DevOps Workload Identity Federation, OIDC allows pipelines to authenticate with Azure without storing client secrets. Azure DevOps generates an OIDC token, Azure AD validates it, and provides temporary access to Azure resources.&quot;" vertex="1">
          <mxGeometry height="80" width="535" x="745" y="15380" as="geometry" />
        </mxCell>
