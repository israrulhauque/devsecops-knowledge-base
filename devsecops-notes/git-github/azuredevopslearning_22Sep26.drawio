        <mxCell id="wv-RGSOru7Oq7TDXAZVd-37" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;strong&gt;Epic = WHAT BIG THING?&lt;/strong&gt;&lt;br&gt;&#xa;&lt;strong&gt;Issue = WHAT PART OF IT?&lt;/strong&gt;&lt;br&gt;&#xa;&lt;strong&gt;Task = HOW/WHAT ACTUAL WORK?&lt;/strong&gt;" vertex="1">
          <mxGeometry height="100" width="240" x="40" y="10440" as="geometry" />
        </mxCell>
        <mxCell id="wv-RGSOru7Oq7TDXAZVd-38" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;p class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;&lt;strong&gt;&quot;What is Epic, Issue and Task in Azure DevOps?&quot;&lt;/strong&gt;&lt;span aria-hidden=&quot;true&quot; class=&quot;PDq2pG_selectionAnchor&quot;&gt;&lt;/span&gt;&lt;/p&gt;&lt;br&gt;&lt;p&gt;Bhai ye answer de:&lt;/p&gt;&lt;br&gt;&lt;blockquote&gt;&lt;br&gt;&lt;p&gt;“In Azure DevOps, we use work items to break down and track the project work. An Epic represents a large business objective or a high-level requirement. We break that Epic into smaller Issues, where each Issue represents a specific requirement or major piece of work. Then we break the Issue into Tasks, which represent the actual technical activities performed by engineers.&lt;strong&gt; &lt;/strong&gt;&lt;b&gt;For example, an Application Deployment Epic can have Issues like CI Pipeline, CD Pipeline and Security, and the CD Pipeline Issue can have Tasks such as creating the YAML pipeline, configuring the agent, deployment stages and approvals.”&lt;/b&gt;&lt;/p&gt;&lt;/blockquote&gt;" vertex="1">
          <mxGeometry height="310" width="560" x="30" y="10540" as="geometry" />
        </mxCell>
        <mxCell id="wv-RGSOru7Oq7TDXAZVd-41" edge="1" parent="1" source="wv-RGSOru7Oq7TDXAZVd-39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=12;fontColor=default;" target="wv-RGSOru7Oq7TDXAZVd-40" value="">
