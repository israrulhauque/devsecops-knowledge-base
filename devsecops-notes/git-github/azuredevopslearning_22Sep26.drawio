        <mxCell id="pFN8Bo_iyDxhCp5ajm9O-1" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Client Secret&lt;/th&gt;&lt;th&gt;OIDC&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;Password based&lt;/td&gt;&lt;td&gt;Token based&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Long-lived secret&lt;/td&gt;&lt;td&gt;Short-lived token&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Secret rotation needed&lt;/td&gt;&lt;td&gt;No rotation&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Risk of leak&lt;/td&gt;&lt;td&gt;Less risk&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Old approach&lt;/td&gt;&lt;td&gt;Modern approach&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="140" width="260" x="857" y="15240" as="geometry" />
        </mxCell>
