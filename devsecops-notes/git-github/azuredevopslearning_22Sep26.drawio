q_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;10 jobs&#xa;  ↓&#xa;Autoscaling&#xa;  ↓&#xa;10 runners&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;2491&quot; data-end=&quot;2505&quot; class=&quot;&quot;&gt;Demand khatam:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;2507&quot; data-end=&quot;2552&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-(--code-block-surface) corner-superellipse/1.1 overflow-clip rounded-3xl [--code-block-surface:var(--bg-elevated-secondary)] dark:[--code-block-surface:var(--composer-surface-primary)] lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;No jobs&#xa;  ↓&#xa;Extra runners removed&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;2554&quot; data-end=&quot;2667&quot; class=&quot;&quot;&gt;GitHub ecosystem mein Kubernetes-based scaling ke liye &lt;strong data-start=&quot;2609&quot; data-end=&quot;2644&quot;&gt;Actions Runner Controller (ARC)&lt;/strong&gt; commonly use hota hai.&lt;/p&gt;&#xa;&lt;hr data-start=&quot;2669&quot; data-end=&quot;2672&quot;&gt;&#xa;&lt;h1 data-section-id=&quot;ge41c2&quot; data-start=&quot;2674&quot; data-end=&quot;2703&quot;&gt;🧠 Ek important distinction&lt;/h1&gt;&#xa;&lt;p data-start=&quot;2705&quot; data-end=&quot;2761&quot;&gt;Bhai &lt;strong data-start=&quot;2710&quot; data-end=&quot;2761&quot;&gt;runner aur runner machine ko confuse mat karna.&lt;/strong&gt;&lt;/p&gt;&#xa;&lt;h3 data-section-id=&quot;p8t8uu&quot; data-start=&quot;2763&quot; data-end=&quot;2773&quot;&gt;Runner&lt;/h3&gt;&#xa;&lt;p data-start=&quot;2775&quot; data-end=&quot;2809&quot;&gt;GitHub Actions ka execution agent.&lt;/p&gt;&#xa;&lt;h3 data-section-id=&quot;2urqr7&quot; data-start=&quot;2811&quot; data-end=&quot;2829&quot;&gt;Runner machine&lt;/h3&gt;&#xa;&lt;p data-start=&quot;2831&quot; data-end=&quot;2871&quot;&gt;Jis machine/VM par runner installed hai.&lt;/p&gt;&#xa;&lt;p data-start=&quot;2873&quot; data-end=&quot;2881&quot;&gt;Example:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;2883&quot; data-end=&quot;2959&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-(--code-block-surface) corner-superellipse/1.1 overflow-clip rounded-3xl [--code-block-surface:var(--bg-elevated-secondary)] dark:[--code-block-surface:var(--composer-surface-primary)] lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Windows VM&#xa;│&#xa;├── Runner-1&#xa;├── Runner-2&#xa;├── Runner-3&#xa;└── Runner-4&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;2961&quot; data-end=&quot;2977&quot;&gt;Ye possible hai.&lt;/p&gt;&#xa;&lt;hr data-start=&quot;2979&quot; data-end=&quot;2982&quot;&gt;&#xa;&lt;h1 data-section-id=&quot;1lhpi5p&quot; data-start=&quot;2984&quot; data-end=&quot;3024&quot;&gt;Interview mein kya answer dena hai? 🎯&lt;/h1&gt;&#xa;&lt;p data-start=&quot;3026&quot; data-end=&quot;3038&quot;&gt;Interviewer:&lt;/p&gt;&#xa;&lt;blockquote data-start=&quot;3040&quot; data-end=&quot;3146&quot;&gt;&#xa;&lt;p data-start=&quot;3042&quot; data-end=&quot;3146&quot;&gt;&lt;strong data-start=&quot;3042&quot; data-end=&quot;3146&quot;&gt;&quot;You have 10 pipelines but only one self-hosted runner. How will you run all pipelines in parallel?&quot;&lt;/strong&gt;&lt;/p&gt;&#xa;&lt;/blockquote&gt;&#xa;&lt;p data-start=&quot;3148&quot; data-end=&quot;3155&quot;&gt;Tu bol:&lt;/p&gt;&#xa;&lt;blockquote data-start=&quot;3157&quot; data-end=&quot;3538&quot;&gt;&#xa;&lt;p data-start=&quot;3159&quot; data-end=&quot;3538&quot;&gt;&lt;strong data-start=&quot;3159&quot; data-end=&quot;3538&quot;&gt;&quot;A single GitHub Actions runner executes one job at a time. If I need 10 jobs to run in parallel, I need sufficient runner capacity. I can configure multiple self-hosted runner instances, but for production I would prefer multiple runner machines or an autoscaling runner solution. GitHub will assign each queued job to an available runner based on labels and runner groups.&quot;&lt;/strong&gt;&lt;/p&gt;&#xa;&lt;/blockquote&gt;&#xa;&lt;h3 data-section-id=&quot;neg9bp&quot; data-start=&quot;3540&quot; data-end=&quot;3570&quot;&gt;Aur agar interviewer bole:&lt;/h3&gt;&#xa;&lt;p data-start=&quot;3572&quot; data-end=&quot;3620&quot;&gt;&lt;strong data-start=&quot;3572&quot; data-end=&quot;3620&quot;&gt;&quot;Can you install 10 runners on one machine?&quot;&lt;/strong&gt;&lt;/p&gt;&#xa;&lt;p data-start=&quot;3622&quot; data-end=&quot;3626&quot;&gt;Bol:&lt;/p&gt;&#xa;&lt;blockquote data-start=&quot;3628&quot; data-end=&quot;3897&quot;&gt;&#xa;&lt;p data-start=&quot;3630&quot; data-end=&quot;3897&quot;&gt;&lt;strong data-start=&quot;3630&quot; data-end=&quot;3897&quot;&gt;&quot;Yes, technically multiple runner instances can run on the same machine, but I would consider CPU, memory, disk and network capacity. For production workloads, I prefer multiple runner VMs or autoscaling to avoid resource contention and provide better isolation.&quot;&lt;/strong&gt;&lt;/p&gt;&#xa;&lt;/blockquote&gt;&#xa;&lt;hr data-start=&quot;3899&quot; data-end=&quot;3902&quot;&gt;&#xa;&lt;h2 data-section-id=&quot;10jmm2s&quot; data-start=&quot;3904&quot; data-end=&quot;3940&quot;&gt;🔥 Tere Azure + GitHub setup mein&lt;/h2&gt;&#xa;&lt;p data-start=&quot;3942&quot; data-end=&quot;3995&quot;&gt;Tu Azure use kar raha hai, to practical architecture:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;3997&quot; data-end=&quot;4397&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-(--code-block-surface) corner-superellipse/1.1 overflow-clip rounded-3xl [--code-block-surface:var(--bg-elevated-secondary)] dark:[--code-block-surface:var(--composer-surface-primary)] lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;                    GitHub&#xa;                      │&#xa;                Actions Jobs&#xa;                      │&#xa;                Runner Group&#xa;                      │&#xa;          ┌───────────┼───────────┐&#xa;          ↓           ↓           ↓&#xa;       Azure VM     Azure VM    Azure VM&#xa;       Runner-1     Runner-2    Runner-3&#xa;          ↓           ↓           ↓&#xa;       Terraform    Terraform   Terraform&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;4399&quot; data-end=&quot;4529&quot;&gt;Aur agar requirement &lt;strong data-start=&quot;4420&quot; data-end=&quot;4447&quot;&gt;10 concurrent pipelines&lt;/strong&gt; hai, to capacity planning karke &lt;strong data-start=&quot;4480&quot; data-end=&quot;4505&quot;&gt;10 concurrent runners&lt;/strong&gt; available rakhne honge.&lt;/p&gt;&#xa;&lt;p data-start=&quot;4531&quot; data-end=&quot;4703&quot; data-is-last-node=&quot;&quot; data-is-only-node=&quot;&quot;&gt;&lt;strong data-start=&quot;4531&quot; data-end=&quot;4545&quot;&gt;Important:&lt;/strong&gt; GitHub-hosted runners mein GitHub automatically fresh runner VMs provide karta hai; self-hosted runners mein &lt;strong data-start=&quot;4655&quot; data-end=&quot;4702&quot;&gt;runner capacity tumhe manage karni hoti hai&lt;/strong&gt;.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;z-0 flex min-h-[46px] justify-start&quot;&gt;&lt;/div&gt;&lt;div aria-hidden=&quot;true&quot; class=&quot;pointer-events-none -mb-px h-px w-full opacity-0&quot;&gt;&lt;/div&gt;" vertex="1">
