          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="RYsPmi5vES3W1vmxjtKf-54" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="service connection&amp;nbsp;" vertex="1">
