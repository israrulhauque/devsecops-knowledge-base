t;color: #007200;&quot;&gt;#&amp;nbsp;--------------------------------------------------------&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;color: #000000;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: #008080;&quot;&gt;task&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt;:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: #0451a5;&quot;&gt;TerraformTask@5&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #000000;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: #008080;&quot;&gt;displayName&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt;:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: #0451a5;&quot;&gt;&quot;Terraform&amp;nbsp;Apply&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #000000;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: #008080;&quot;&gt;inputs&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt;:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #000000;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: #008080;&quot;&gt;provider&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt;:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: #0451a5;&quot;&gt;&quot;azurerm&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #000000;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: #008080;&quot;&gt;command&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt;:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: #0451a5;&quot;&gt;&quot;apply&quot;&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;color: #000000;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: #008080;&quot;&gt;environmentServiceNameAzureRM&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt;:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: #0451a5;&quot;&gt;&quot;arun_SVC&quot;&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;color: #000000;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: #008080;&quot;&gt;commandOptions&lt;/span&gt;&lt;span style=&quot;color: #000000;&quot;&gt;:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: #0451a5;&quot;&gt;&quot;$(Pipeline.Workspace)/terraform-plan/tfplan&quot;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
