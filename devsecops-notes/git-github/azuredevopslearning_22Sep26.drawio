        <mxCell id="bPllanAipsPgOedq6P1s-13" parent="1" style="whiteSpace=wrap;html=1;rounded=0;" value="pick-1&lt;div&gt;pick -2&lt;/div&gt;&lt;div&gt;second wala pick usko hm chnage krke S-squash&lt;/div&gt;&lt;div&gt;edit krne k liye &quot;i&quot; press kege&amp;nbsp;&lt;/div&gt;&lt;div&gt;p--&amp;gt;s&lt;/div&gt;&lt;div&gt;esc use krge&amp;nbsp;&lt;/div&gt;&lt;div&gt;edit s bahar aane k liye hm :wq&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;git log --oneline (two commit ek single line p aa jaega)&lt;/div&gt;" vertex="1">
