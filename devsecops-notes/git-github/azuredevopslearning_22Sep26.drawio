        </mxCell>
        <mxCell id="bPllanAipsPgOedq6P1s-18" parent="1" style="text;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" value="git cherry-pick" vertex="1">
          <mxGeometry height="40" width="110" x="-100" y="5520" as="geometry" />
        </mxCell>
        <mxCell id="bPllanAipsPgOedq6P1s-19" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;gradientColor=none;" value="&#xa;Git cherry-pick is used to apply a specific commit from one branch into another branch. It does not merge the entire branch, only selected commits. It is useful for hotfixes or when we need only a particular change without merging the full feature branch. We use &lt;code data-start=&quot;2217&quot; data-end=&quot;2246&quot;&gt;git cherry-pick &amp;lt;commit-id&amp;gt;&lt;/code&gt; to apply the commit.&#xa;&#xa;" vertex="1">
          <mxGeometry height="140" width="255" x="75" y="5470" as="geometry" />
        </mxCell>
        <mxCell id="bPllanAipsPgOedq6P1s-23" edge="1" parent="1" source="bPllanAipsPgOedq6P1s-21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="bPllanAipsPgOedq6P1s-22" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bPllanAipsPgOedq6P1s-21" parent="1" style="text;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="git revert" vertex="1">
          <mxGeometry height="40" width="80" x="-100" y="5700" as="geometry" />
        </mxCell>
        <mxCell id="bPllanAipsPgOedq6P1s-22" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;gradientColor=none;" value="agr maine koi galat code commit kr diya apni main brnach p tho usko revert krne k liye hm git revert &quot;coomitid&quot; tho mere purne code m aa jaega&amp;nbsp;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&quot;Undo commit safely without deleting history”&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Git revert is used to undo a specific commit by creating a new commit that reverses the changes of the original commit. It is safe for production because it does not delete commit history, unlike git reset. It preserves the project history and is commonly used to rollback faulty deployments.&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="270" x="70" y="5630" as="geometry" />
        </mxCell>
        <mxCell id="bPllanAipsPgOedq6P1s-26" edge="1" parent="1" source="bPllanAipsPgOedq6P1s-24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="bPllanAipsPgOedq6P1s-25" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bPllanAipsPgOedq6P1s-24" parent="1" style="text;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" value="git tag" vertex="1">
          <mxGeometry height="40" width="70" x="-93.75" y="5895" as="geometry" />
        </mxCell>
        <mxCell id="bPllanAipsPgOedq6P1s-25" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;gradientColor=none;" value="&#xa;Git tags are used to mark specific commits in Git history, usually for release versions. Unlike branches, tags do not move and are fixed pointers to a specific commit. They are commonly used in DevOps pipelines to track production releases like v1.0, v2.0. We can create tags using &lt;code data-start=&quot;2292&quot; data-end=&quot;2301&quot;&gt;git tag&lt;/code&gt; or annotated tags using &lt;code data-start=&quot;2326&quot; data-end=&quot;2338&quot;&gt;git tag -a&lt;/code&gt;.&#xa;&#xa;" vertex="1">
          <mxGeometry height="150" width="255" x="75" y="5840" as="geometry" />
        </mxCell>
        <mxCell id="bPllanAipsPgOedq6P1s-29" edge="1" parent="1" source="bPllanAipsPgOedq6P1s-27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="bPllanAipsPgOedq6P1s-28" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
