        <mxCell id="yDdN5bamgGrf4BBukidz-55" parent="1" style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;rounded=0;" value="&lt;br&gt;In a Centralized Version Control System, there is one central repository that contains the complete project. Every developer works by connecting to this central repository. All commits, updates, and version history are managed from the central server.&lt;div&gt;&lt;div&gt;Advantages&lt;/div&gt;&lt;div&gt;Single source of truth.&lt;/div&gt;&lt;div&gt;Easy to manage permissions and access.&lt;/div&gt;&lt;div&gt;Simple for small teams.&lt;/div&gt;&lt;div&gt;Centralized backup and auditing.&lt;/div&gt;&lt;div&gt;Disadvantages&lt;/div&gt;&lt;div&gt;If the central server is down, developers cannot commit changes.&lt;/div&gt;&lt;div&gt;Requires network connectivity.&lt;/div&gt;&lt;div&gt;Single point of failure.&lt;/div&gt;&lt;div&gt;Slower for distributed teams.&lt;/div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="670" x="1020" y="90" as="geometry" />
        </mxCell>
        <mxCell id="yDdN5bamgGrf4BBukidz-56" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;rounded=0;" value="&#xa;In a Distributed Version Control System, every developer has a full copy of the project on their local machine. They can create branches, commit changes, view history, and even work offline. Later, they can push their changes to a remote repository such as GitHub, Azure Repos, or GitLab.&#xa;&#xa;" vertex="1">
          <mxGeometry height="60" width="700" x="1020" y="410" as="geometry" />
        </mxCell>
        <mxCell id="yDdN5bamgGrf4BBukidz-57" edge="1" parent="1" source="yDdN5bamgGrf4BBukidz-58" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="yDdN5bamgGrf4BBukidz-61" value="">
