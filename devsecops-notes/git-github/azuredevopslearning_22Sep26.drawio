          <mxGeometry height="40" width="120" x="40" y="12990" as="geometry" />
        </mxCell>
        <mxCell id="wv-RGSOru7Oq7TDXAZVd-81" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="variable groups" vertex="1">
          <mxGeometry height="40" width="120" x="240" y="12940" as="geometry" />
        </mxCell>
        <mxCell id="wv-RGSOru7Oq7TDXAZVd-82" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="Secure file" vertex="1">
          <mxGeometry height="40" width="120" x="240" y="13030" as="geometry" />
        </mxCell>
        <mxCell id="wv-RGSOru7Oq7TDXAZVd-83" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="175" width="668" x="450" y="12910" as="geometry" />
        </mxCell>
        <mxCell id="wv-RGSOru7Oq7TDXAZVd-85" edge="1" parent="1" source="wv-RGSOru7Oq7TDXAZVd-80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=-0.018;entryY=0.6;entryDx=0;entryDy=0;entryPerimeter=0;fontFamily=Helvetica;fontSize=12;fontColor=default;" target="wv-RGSOru7Oq7TDXAZVd-82">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wv-RGSOru7Oq7TDXAZVd-86" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="variable groups" vertex="1">
          <mxGeometry height="40" width="120" x="40" y="13160" as="geometry" />
        </mxCell>
        <mxCell id="wv-RGSOru7Oq7TDXAZVd-87" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;br&gt;Variable Group ek common locker hai jahan hum pipeline mein use hone wale variables aur secrets ko ek jagah store karte hain, aur multiple pipelines unhe reuse kar sakti hain.&lt;div&gt;senstive values can be linked through azure key vault.&lt;br&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;variables:&lt;/div&gt;&lt;div&gt;- group: PROD-VARIABLES&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;steps:&lt;/div&gt;&lt;div&gt;- script: |&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; echo &quot;Environment: $(ENVIRONMENT)&quot;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; echo &quot;API URL: $(API_URL)&quot;&lt;/div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="480" x="80" y="13200" as="geometry" />
        </mxCell>
        <mxCell id="wv-RGSOru7Oq7TDXAZVd-88" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="Secure file" vertex="1">
          <mxGeometry height="40" width="120" x="40" y="13520" as="geometry" />
        </mxCell>
        <mxCell id="wv-RGSOru7Oq7TDXAZVd-91" parent="1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;br&gt;Secure File = koi sensitive/important file jise hum pipeline ke andar securely store karke runtime par use karna chahte hain.&lt;div&gt;&lt;div&gt;.pfx certificate&lt;/div&gt;&lt;div&gt;.pem / .key file&lt;/div&gt;&lt;div&gt;Android .keystore&lt;/div&gt;&lt;div&gt;Apple provisioning profile&lt;/div&gt;&lt;div&gt;SSH private key&lt;/div&gt;&lt;div&gt;Terraform .tfvars file — possible hai, but secrets ke liye usually Variable Groups/Key Vault better choice hoti hai.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Azure DevOps me Library → Secure files me upload karte ho. File ko normal repository me rakhne ki zarurat nahi padti.&lt;/div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="460" x="100" y="13560" as="geometry" />
        </mxCell>
        <UserObject label="&lt;h3 class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;🧠 Real-life example&lt;span aria-hidden=&quot;true&quot; class=&quot;PDq2pG_selectionAnchor&quot;&gt;&lt;/span&gt;&lt;/h3&gt;&#xa;&lt;p&gt;Maan le bhai tumhare paas ek &lt;strong&gt;SSL certificate&lt;/strong&gt; hai:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-(--code-block-surface) corner-superellipse/1.1 overflow-clip rounded-3xl [--code-block-surface:var(--bg-elevated-secondary)] dark:[--code-block-surface:var(--composer-surface-primary)] lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;company-prod.pfx&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p&gt;Tumhari pipeline ko production deployment ke time ye certificate chahiye.&lt;/p&gt;&#xa;&lt;p&gt;❌ Galat approach:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-(--code-block-surface) corner-superellipse/1.1 overflow-clip rounded-3xl [--code-block-surface:var(--bg-elevated-secondary)] dark:[--code-block-surface:var(--composer-surface-primary)] lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Git Repository&#xa;   |&#xa;   └── company-prod.pfx&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p&gt;Problem: repository me certificate aa gaya. Agar kisi ko repo ka access mil gaya, sensitive file expose ho sakti hai.&lt;/p&gt;&#xa;&lt;p&gt;✅ Better approach:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-(--code-block-surface) corner-superellipse/1.1 overflow-clip rounded-3xl [--code-block-surface:var(--bg-elevated-secondary)] dark:[--code-block-surface:var(--composer-surface-primary)] lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Azure DevOps&#xa;   |&#xa;   └── Library&#xa;        |&#xa;        └── Secure Files&#xa;              |&#xa;              └── company-prod.pfx&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p&gt;Pipeline jab chalegi, Azure DevOps securely file ko download karega aur deployment ke time use karega.&lt;/p&gt;&#xa;&lt;hr&gt;&#xa;&lt;h3&gt;🔄 Pipeline me flow kaise chalega?&lt;/h3&gt;&#xa;&lt;p&gt;Simple flow:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min