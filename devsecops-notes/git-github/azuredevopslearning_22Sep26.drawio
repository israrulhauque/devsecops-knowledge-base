        <mxCell id="wv-RGSOru7Oq7TDXAZVd-79" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;strong&gt;Aur bhai ek important point:&lt;/strong&gt; 429 dekhte hi &lt;strong&gt;“permissions issue” mat bolna&lt;/strong&gt;. &lt;code&gt;401/403&lt;/code&gt; generally authentication/authorization direction mein le jaate hain; &lt;strong&gt;429 ka first direction throttling/rate limit&lt;/strong&gt; hona chahiye." vertex="1">
          <mxGeometry height="70" width="560" x="20" y="12800" as="geometry" />
        </mxCell>
        <mxCell id="wv-RGSOru7Oq7TDXAZVd-84" edge="1" parent="1" source="wv-RGSOru7Oq7TDXAZVd-80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=12;fontColor=default;" target="wv-RGSOru7Oq7TDXAZVd-81">
