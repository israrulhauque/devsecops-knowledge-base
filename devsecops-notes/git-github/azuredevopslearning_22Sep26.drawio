        <mxCell id="X05yxIpQEAwgmfd0lghe-69" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;ul style=&quot;box-sizing: inherit; outline-color: inherit; margin: 16px 0px; padding: 0px; list-style: none; overflow-wrap: break-word; margin-inline-start: 38px; color: rgb(22, 22, 22); font-family: &amp;quot;Segoe UI&amp;quot;, &amp;quot;Segoe UI Variable Text&amp;quot;, -apple-system, BlinkMacSystemFont, &amp;quot;Helvetica Neue&amp;quot;, Helvetica, Arial, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;li style=&quot;box-sizing: inherit; outline-color: inherit; margin: 0px; padding: 0px; outline-style: initial; outline-width: 0px; list-style: outside;&quot;&gt;&lt;strong style=&quot;box-sizing: inherit; outline-color: inherit; font-weight: 600;&quot;&gt;Succeeded or failed&lt;/strong&gt;: Run even if a previous dependency fails, unless the run is canceled. To apply this condition, specify&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code style=&quot;box-sizing: inherit; outline-color: inherit; font-family: SFMono-Regular, Consolas, &amp;quot;Liberation Mono&amp;quot;, Menlo, Courier, monospace; font-size: 13.6px; direction: ltr; background-color: rgb(230, 230, 230); overflow-wrap: break-word; border-radius: 3px; padding: 0.1em 0.2em;&quot;&gt;condition: succeededOrFailed()&lt;/code&gt;.&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="110" width="630" x="-1280" y="69330" as="geometry" />
        </mxCell>
        <mxCell id="X05yxIpQEAwgmfd0lghe-70" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;ul style=&quot;box-sizing: inherit; outline-color: inherit; margin: 16px 0px; padding: 0px; list-style: none; overflow-wrap: break-word; margin-inline-start: 38px; color: rgb(22, 22, 22); font-family: &amp;quot;Segoe UI&amp;quot;, &amp;quot;Segoe UI Variable Text&amp;quot;, -apple-system, BlinkMacSystemFont, &amp;quot;Helvetica Neue&amp;quot;, Helvetica, Arial, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;li style=&quot;box-sizing: inherit; outline-color: inherit; margin: 0px; padding: 0px; outline-style: initial; outline-width: 0px; list-style: outside;&quot;&gt;&lt;strong style=&quot;box-sizing: inherit; outline-color: inherit; font-weight: 600;&quot;&gt;Always&lt;/strong&gt;: Run even if a previous dependency fails, even if the run is canceled. To apply this condition, specify&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code style=&quot;box-sizing: inherit; outline-color: inherit; font-family: SFMono-Regular, Consolas, &amp;quot;Liberation Mono&amp;quot;, Menlo, Courier, monospace; font-size: 13.6px; direction: ltr; background-color: rgb(230, 230, 230); overflow-wrap: break-word; border-radius: 3px; padding: 0.1em 0.2em;&quot;&gt;condition: always()&lt;/code&gt;.&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="90" width="640" x="-1280" y="69480" as="geometry" />
        </mxCell>
        <mxCell id="X05yxIpQEAwgmfd0lghe-71" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;h2 dir=&quot;auto&quot; class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;&lt;span role=&quot;text&quot;&gt;&lt;code&gt;always()&lt;/code&gt; ka matlab&lt;/span&gt;&lt;span aria-hidden=&quot;true&quot; class=&quot;PDq2pG_selectionAnchor&quot;&gt;&lt;/span&gt;&lt;/h2&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;relative h-full w-full border-radius-3xl bg-(--code-block-surface) corner-superellipse/1.1 overflow-clip rounded-3xl [--code-block-surface:var(--bg-elevated-secondary)] dark:[--code-block-surface:var(--composer-surface-primary)] lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute inset-x-4 top-12 bottom-4&quot;&gt;&lt;div class=&quot;pointer-events-none sticky z-40 shrink-0 z-1!&quot;&gt;&lt;div class=&quot;sticky bg-token-border-light&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;condition: always()&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p dir=&quot;auto&quot; class=&quot;&quot;&gt;iska simple meaning hai:&lt;/p&gt;&#xa;&lt;blockquote&gt;&#xa;&lt;p dir=&quot;auto&quot;&gt;&lt;strong&gt;&quot;Pehle wala task/job/stage successful ho, fail ho, ya cancel ho — mera wala kaam hamesha run karna hai.&quot;&lt;/strong&gt;&lt;/p&gt;&#xa;&lt;/blockquote&gt;&#xa;&lt;p dir=&quot;auto&quot;&gt;Bas &lt;strong&gt;ek exception&lt;/strong&gt; hota hai: kuch conditions mein parent/dependency structure ki wajah se execution possible hi na ho, lekin normal success/failure/cancel states mein &lt;code&gt;always()&lt;/code&gt; run karne ke liye designed hai.&lt;/p&gt;" vertex="1">
          <mxGeometry height="380" width="640" x="-1280" y="69590" as="geometry" />
        </mxCell>
        <mxCell id="X05yxIpQEAwgmfd0lghe-72" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;ul style=&quot;box-sizing: inherit; outline-color: inherit; margin: 16px 0px; padding: 0px; list-style: none; overflow-wrap: break-word; margin-inline-start: 38px; color: rgb(22, 22, 22); font-family: &amp;quot;Segoe UI&amp;quot;, &amp;quot;Segoe UI Variable Text&amp;quot;, -apple-system, BlinkMacSystemFont, &amp;quot;Helvetica Neue&amp;quot;, Helvetica, Arial, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;li style=&quot;box-sizing: inherit; outline-color: inherit; margin: 0px; padding: 0px; outline-style: initial; outline-width: 0px; list-style: outside;&quot;&gt;&lt;strong style=&quot;box-sizing: inherit; outline-color: inherit; font-weight: 600;&quot;&gt;Failed&lt;/strong&gt;: Run only when a previous dependency fails. To apply this condition, specify&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code style=&quot;box-sizing: inherit; outline-color: inherit; font-family: SFMono-Regular, Consolas, &amp;quot;Liberation Mono&amp;quot;, Menlo, Courier, monospace; font-size: 13.6px; direction: ltr; background-color: rgb(230, 230, 230); overflow-wrap: break-word; border-radius: 3px; padding: 0.1em 0.2em;&quot;&gt;condition: failed()&lt;/code&gt;.&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="90" width="640" x="-1280" y="70000" as="geometry" />
        </mxCell>
        <mxCell id="X05yxIpQEAwgmfd0lghe-73" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Condition&lt;/th&gt;&lt;th&gt;Simple Hindi&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;succeeded()&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;strong&gt;Pehle wala successful ho → chalo&lt;/strong&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;failed()&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;strong&gt;Pehle wala fail ho → chalo&lt;/strong&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;succeededOrFailed()&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;strong&gt;Pehle wala success/fail kuch bhi ho → chalo&lt;/strong&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;always()&lt;/code&gt;&lt;/td&gt;&lt;td&gt;&lt;strong&gt;Success/fail/cancel hone par bhi chalo&lt;/strong&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="120" width="510" x="-1280" y="70110" as="geometry" />
